{
  "name": "dronerfdiy-radio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:redio": "vite --config vite.redio.config.ts --port=3001 --host=0.0.0.0",
    "verify:banks": "bun run scripts/verify-r2-banks.ts",
    "verify:ham-tools": "bun run scripts/verify-ham-tools.ts",
    "build": "bun run verify:banks && bun run verify:ham-tools && vite build && vite build --config vite.redio.config.ts && node scripts/copy-drone-routes.mjs",
    "preview": "vite preview --host=0.0.0.0",
    "lint": "tsc --noEmit",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "canvas-confetti": "^1.9.4",
    "fflate": "^0.8.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.124.0"
  }
}
